# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted (e.g. https://dsecure-mg.vercel.app).
APP_URL="MY_APP_URL"

# ------------------------------------------------------------------
# D SECURE ADMIN & VERCEL PRODUCTION ENVIRONMENT VARIABLES
# ------------------------------------------------------------------
# Mot de passe administrateur (à configurer impérativement dans Vercel)
ADMIN_PASSWORD=

# Clé secrète HMAC-SHA256 pour signer les sessions administrateur (chaîne aléatoire longue)
ADMIN_SECRET=

# Base de données persistante pour Vercel (choisir UNE des options ci-dessous) :
# Option 1 - PostgreSQL (Neon, Vercel Postgres, Supabase) :
DATABASE_URL=

# Option 2 - Upstash Redis / Vercel KV :
KV_REST_API_URL=
KV_REST_API_TOKEN=

# Option 3 (Optionnel) - Vercel Blob pour le stockage CDN des images importées :
BLOB_READ_WRITE_TOKEN=
